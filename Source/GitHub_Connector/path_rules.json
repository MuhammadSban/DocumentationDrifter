{
  "rules": [
    {"pattern": "requirements/**", "category": "REQUIREMENT"},
    {"pattern": "docs/requirements/**", "category": "REQUIREMENT"},
    {"pattern": "**/REQUIREMENTS*.md", "category": "REQUIREMENT"},
    {"pattern": "spec/**", "category": "SPECIFICATION"},
    {"pattern": "specs/**", "category": "SPECIFICATION"},
    {"pattern": "docs/spec/**", "category": "SPECIFICATION"},
    {"pattern": "docs/specs/**", "category": "SPECIFICATION"},
    {"pattern": "**/openapi*.yaml", "category": "SPECIFICATION"},
    {"pattern": "**/openapi*.yml", "category": "SPECIFICATION"},
    {"pattern": "**/openapi*.json", "category": "SPECIFICATION"},
    {"pattern": "docs/architecture/**", "category": "ARCHITECTURE"},
    {"pattern": "**/ARCHITECTURE*.md", "category": "ARCHITECTURE"},
    {"pattern": "**/model_config.*", "category": "ARCHITECTURE"},
    {"pattern": "docs/design/**", "category": "DESIGN"},
    {"pattern": "docs/adr/**", "category": "DESIGN"},
    {"pattern": "**/DESIGN*.md", "category": "DESIGN"},
    {"pattern": "**/*.py", "category": "IMPLEMENTATION"},
    {"pattern": "**/*.ipynb", "category": "IMPLEMENTATION"},
    {"pattern": "**/*.js", "category": "IMPLEMENTATION"},
    {"pattern": "**/*.ts", "category": "IMPLEMENTATION"},
    {"pattern": "**/*.java", "category": "IMPLEMENTATION"},
    {"pattern": "**/*.c", "category": "IMPLEMENTATION"},
    {"pattern": "**/*.h", "category": "IMPLEMENTATION"},
    {"pattern": "**/*.cpp", "category": "IMPLEMENTATION"},
    {"pattern": "**/*.hpp", "category": "IMPLEMENTATION"},
    {"pattern": "**/*.go", "category": "IMPLEMENTATION"},
    {"pattern": "**/*.rs", "category": "IMPLEMENTATION"},
    {"pattern": "**/*.rb", "category": "IMPLEMENTATION"},
    {"pattern": "**/*.sh", "category": "IMPLEMENTATION"},
    {"pattern": "**/*.sql", "category": "IMPLEMENTATION"}
  ],
  "fallback": "OTHER",
  "supported_extensions": [".py", ".ipynb", ".js", ".ts", ".java", ".c", ".h", ".cpp", ".hpp", ".go", ".rs", ".rb", ".sh",
    ".sql", ".md", ".rst", ".txt", ".yaml", ".yml", ".json", ".toml", ".cfg", ".ini", ".csv"],
  "supported_filenames": ["LICENSE", "Makefile", "Dockerfile", "README", "CODEOWNERS"]
}
